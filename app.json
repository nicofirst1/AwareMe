{
  "expo": {
    "name": "AwareMe",
    "slug": "awareme",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "awareme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nicolobrandizzi.awareme"
    },
    "android": {
      "package": "com.nicolobrandizzi.awareme",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#fef5e8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-local-authentication",
      "./scripts/with-android-signing.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fef5e8",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
